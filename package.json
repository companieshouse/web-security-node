{
  "name": "@companieshouse/web-security-node",
  "version": "0.0.0",
  "description": "Middleware for chs authentication",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "types": "dist/index.d.ts",
  "repository": "git@github.com:companieshouse/web-security-node.git",
  "license": "MIT",
  "scripts": {
    "test": "nyc --reporter=lcov --reporter=text mocha 'test/**/*.test.ts'",
    "build": "rm -rf ./dist; tsc",
    "lint": "eslint 'src/*.ts' 'src/**/*.ts' 'test/**/*.test.ts'",
    "lint:fix": "eslint 'src/*.ts' 'src/**/*.ts' 'test/**/*.test.ts' --fix",
    "prepublishOnly": "[ ! -d node_modules ] && npm install; tsc",
    "postpublish": "rm -rf lib",
    "test:coverage": "nyc --check-coverage --reporter=text-summary npm run test",
    "coverage:report": "nyc --reporter=lcov --reporter=text npm run test"
  },
  "dependencies": {
    "@companieshouse/node-session-handler": "~5.2.21",
    "@companieshouse/structured-logging-node": "~2.0.15",
    "express-async-handler": "^1.2.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/express": "^5.0.6",
    "@types/ioredis": "^4.28.10",
    "@types/mocha": "^10.0.10",
    "@types/sinon": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "chai": "^6.3.0",
    "eslint": "^10.12.0",
    "express": "^5.2.1",
    "mocha": "^12.0.3",
    "nyc": "^18.0.0",
    "sinon": "^22.1.0",
    "ts-mockito": "^2.5.0",
    "ts-node": "^10.8.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "adm-zip": "^0.6.1",
    "@opentelemetry/propagator-jaeger": "^2.9.0",
    "brace-expansion": "5.0.12",
    "browserslist": "^4.28.9",
    "diff": "^8.0.3",
    "glob": "13.0.6",
    "glob-parent": "^6.0.2",
    "js-yaml": "5.4.3",
    "minimatch": "10.2.6",
    "protobufjs": "7.6.5",
    "qs": "^6.16.0",
    "serialize-javascript": "^7.0.5"
  },
  "files": [
    "components",
    "dist"
  ]
}
